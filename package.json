{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "Collection of pi extensions",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "scripts",
    "skills",
    "skills-manifest.json"
  ],
  "bin": {
    "pi-sync": "./extensions/sync/cli.mjs",
    "pi-usage": "./extensions/usage/cli.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.2",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "postinstall": "node scripts/patch-codegraph.mjs && node scripts/welcome.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:screenshots": "node scripts/screenshots/capture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:node": "node tests/codegraph/smoke/smoke-node.mjs",
    "e2e:background-jobs": "node tests/background-jobs/e2e-rpc.mjs",
    "e2e:context-cap": "node tests/context-cap/e2e-rpc.mjs",
    "e2e:edit-assist": "node tests/edit-assist/e2e-rpc.mjs",
    "e2e:initial-context": "node tests/initial-context/e2e-rpc.mjs",
    "e2e:pruning": "node tests/pruning/e2e-rpc.mjs",
    "e2e:quota": "node tests/quota/e2e-rpc.mjs",
    "e2e:resource-toggle": "node tests/resource-toggle/e2e-rpc.mjs",
    "e2e:safe-branch-summary": "node tests/safe-branch-summary/e2e.mjs",
    "e2e:skills": "node tests/skills/e2e-update.mjs",
    "e2e:sync": "node tests/sync/e2e-gist.mjs",
    "e2e:usage": "node tests/usage/e2e-rpc.mjs",
    "skills:update": "node scripts/skills/update.mjs",
    "skills:add": "node scripts/skills/add.mjs"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "^1.6.0",
    "jiti": "^2.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
