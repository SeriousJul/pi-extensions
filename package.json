{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "Collection of pi extensions",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "scripts"
  ],
  "bin": {
    "pi-sync": "./extensions/sync/cli.mjs",
    "pi-usage": "./extensions/usage/cli.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.4.1",
    "typebox": "^1.3.28",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-codegraph.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:node": "node tests/codegraph/smoke/smoke-node.mjs",
    "e2e:context-cap": "node tests/context-cap/e2e-rpc.mjs",
    "e2e:initial-context": "node tests/initial-context/e2e-rpc.mjs",
    "e2e:quota": "node tests/quota/e2e-rpc.mjs",
    "e2e:sync": "node tests/sync/e2e-gist.mjs",
    "e2e:usage": "node tests/usage/e2e-rpc.mjs"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "^1.6.0",
    "jiti": "^2.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
