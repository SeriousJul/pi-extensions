  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^22.20.1",
    "typebox": "1.3.7",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "postinstall": "node scripts/patch-codegraph.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.0"
