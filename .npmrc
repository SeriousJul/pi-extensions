# Skip the registry audit request during install.
#
# `pi install` for git packages runs `npm install --omit dev` in the clone
# and has no timeout on it. The npm registry audit endpoint
# (/-/npm/v1/security/advisories/bulk) intermittently hangs: the TLS
# connection establishes but no response arrives, so every install stalls
# forever on the audit step (metadata and tarball endpoints are unaffected).
# This repo's dependency tree is two self-contained packages; run `npm audit`
# manually when you want an advisory check.
audit=false
